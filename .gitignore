artifacts/archives/*.patch

# --- tg-engine (dilebur dari ~/tg-trading-engine, 4 Nov 2026) ---
# Kode di-versioned; venv, sesi Telethon, dan DB sinyal = state runtime lokal.
# trading_session.session adalah kredensial login — JANGAN pernah di-commit.
services/tg-engine/venv/
services/tg-engine/*.session
services/tg-engine/*.session-journal
services/tg-engine/*.db

# --- worktree lokal agent (bukan sumber repo) ---
tools/warroom-work/

# Riwayat chat agent (93K, 57 sesi) — bukan sumber repo, hanya arsip lokal.
docs/arsip/catatan-lama/hermes_war_sessions.json

# Sejak 5 Nov 2026 engine.py IKUT di-commit: kredensial Telegram sudah pindah ke
# environment (TG_API_ID/TG_API_HASH di /etc/warroom/tg-engine.env). Sebelumnya baris
# ini menyembunyikan inti listener sehingga unit tidak bisa direproduksi dari repo.
# Catatan arsip yang menyebut POLA secret=<...> — gitleaks false positive, tetap tidak di-commit
# agar riwayat git bebas dari pola yang menyerupai kredensial.
docs/arsip/catatan-lama/RINGKASAN_WARROOM.md

