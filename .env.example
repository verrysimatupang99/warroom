# Contoh konfigurasi War Room — SALIN ke `.env` lalu isi nilai asli.
# Jangan pernah commit `.env`; CI gitleaks akan menolaknya.
#
# Nilai di bawah semuanya placeholder. Nama variabel diambil dari berkas env
# nyata di host produksi (/etc/warroom/*.env) dan pembacaan `os.environ` di
# kode, jadi daftar ini bisa diverifikasi ulang dengan:
#   grep -rho 'WARROOM_[A-Z0-9_]*' packages services ops | sort -u

# --- Wajib: database -------------------------------------------------------
# Dipakai API, worker, dan ops/check-db-head.py. Postgres 16.
WARROOM_DB_URL=postgresql+psycopg://warroom:GANTI_SANDI@127.0.0.1:5432/warroom
# 1 di produksi → unit menolak naik bila skema DB bukan di head alembic.
CHECK_DB_HEAD_REQUIRED=1

# --- Wajib: lokasi data domain --------------------------------------------
# State runtime (ledger, verdicts, deals.csv) TIDAK ada di repo.
WARROOM_DOMAIN_HOME=/home/admin/live-trading
WARROOM_STATE_DIR=/home/admin/live-trading/state

# --- API & sesi ------------------------------------------------------------
# Token untuk pemanggil mesin (EA, skrip ops). Jangan pakai untuk manusia.
WARROOM_SERVICE_TOKEN=GANTI_TOKEN_PANJANG_ACAK
# Alamat API lokal, dipakai skrip ops (default http://127.0.0.1:8800).
WARROOM_API=http://127.0.0.1:8800
# Bangun web: PUBLIC_API_BASE kosong = same-origin lewat nginx.
PUBLIC_API_BASE=
WARROOM_BUILD_ID=dev
# 1 → metrik diekspos ke publik (produksi memakai 1 di belakang nginx /metrics lokal).
WARROOM_METRICS_PUBLIC=0

# --- Notifikasi Telegram ---------------------------------------------------
WARROOM_TELEGRAM_BOT_TOKEN=
WARROOM_TELEGRAM_CHAT_ID=
WARROOM_TELEGRAM_THREAD_ID=

# --- Sumber pasar (opsional; kosongkan bila fitur tidak dipakai) -----------
# IDX
WARROOM_IDX_API_KEY=
# Kripto — bursa
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_API_KEY_NAME=
OKX_API_IP=
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_READONLY_PROXY=

# --- LLM (gateway ber-grounding) ------------------------------------------
# Laya (forex) dimatikan default: tanpa saklar ini endpoint menjawab
# tersedia:false, bukan menjalankan model yang bisa menjatuhkan API.
WARROOM_LAYA_ENABLE=0
WARROOM_LAYA_VERDICT_LOG=/var/lib/warroom/laya_verdict_log.csv
WARROOM_MT5_STATUS_URL=http://127.0.0.1:8800/api/v1/tencent/mt5/status

# --- Uji ------------------------------------------------------------------
# Tes butuh Postgres sungguhan; tanpa ini suite DB dilewati (bukan lulus).
WARROOM_TEST_DB_URL=postgresql+psycopg://warroom:GANTI_SANDI@127.0.0.1:5432/warroom_test
WARROOM_E2E_PASS=
# Berkas jurnal sinyal sintetis untuk e2e; produksi tidak menyetel ini.
WARROOM_JURNAL_SINYAL=
