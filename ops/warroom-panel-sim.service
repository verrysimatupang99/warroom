[Unit]
Description=War Room - simulator 3 panel (A/B/C) skema sizing + daily ratchet
After=network-online.target warroom-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/warroom
Environment=HOME=/home/admin
Environment=WARROOM_API=http://127.0.0.1:8800
Environment=PANEL_STATE=/var/lib/warroom/panels.json
Environment=PANEL_LOG=/var/lib/warroom/panels_trades.csv
ExecStart=/home/admin/warroom/.venv/bin/python /home/admin/warroom/ops/panel_sim.py
TimeoutStartSec=120
