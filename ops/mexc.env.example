# Contoh konfigurasi kredensial MEXC (Futures) — READ-ONLY / tanpa dana.
# Salin ke /etc/warroom/mexc.env (mode 600, root):
#
#   sudo install -m 600 -o root -g root ops/mexc.env.example /etc/warroom/mexc.env
#   sudo systemctl restart warroom-api.service warroom-worker.service
#
# ATURAN (wajib):
#   1) Kunci TIDAK PERNAH masuk repo, log, atau badan pesan. Berkas asli hanya di
#      /etc/warroom/mexc.env (root, mode 600). Contoh ini tanpa nilai.
#   2) Buat kunci dengan izin MINIMAL:
#        - HANYA "Trade" (baca posisi + eksekusi) — JANGAN aktifkan Withdraw.
#        - Aktifkan IP whitelist bila memungkinkan (host War Room).
#      Kunci tanpa dana = risiko nyata hanya pada saldo akun, bukan dana besar.
#   3) Selama gate belum lolos: kedudukan tetap PAPER. Kehadiran kunci TIDAK
#      mengaktifkan live. `armed` tetap false; `live.start` tetap 409.

# --- Kunci API (dari MEXC API Management) ------------------------------------------------
MEXC_API_KEY=
MEXC_API_SECRET=

# --- Saklar keamanan (biarkan apa adanya sampai pemilik memutuskan) ----------------------
# Tulis 'paper' untuk memaksa mode paper (baca posisi boleh, eksekusi tidak).
# Ganti ke 'live' HANYA atas keputusan eksplisit pemilik DAN setelah gate lolos.
WARROOM_MEXC_MODE=paper

# --- Jenis pasar: FUTURES (perpetual) — disamakan dengan mesin yang sudah jalan ----------
# Bukti: mesin crypto yang ada memakai contract.mexc.com/api/v1/contract/* dan
# fapi.binance.com (futures). Spot TIDAK dipakai. Buat kunci API pada akun Futures.
WARROOM_MEXC_MARKET=futures

# --- Endpoint (publik baca-harga; tidak butuh kunci) -------------------------------------
# Kolektor harga sudah memakai ini tanpa kredensial:
#   https://contract.mexc.com/api/v1/contract/ticker?symbol={sym}
#   https://contract.mexc.com/api/v1/contract/kline/{sym}?interval={iv}&start={s}&end={e}
#   https://contract.mexc.com/api/v1/contract/funding_rate/{sym}
MEXC_FUTURES_BASE=https://contract.mexc.com

# Catatan: hanya untuk Futures (perpetual). Tanpa MEXC_API_KEY/SECRET, semua jalur
# eksekusi harus jatuh ke mode PAPER dan menampilkan alasannya apa adanya di UI.
