[Unit]
Description=War Room: satu siklus dompet paper $20 (crypto) — jalur sama dgn produksi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/warroom
EnvironmentFile=/etc/warroom/db.env
Environment=LT_HOME=/home/admin/live-trading/state-paper20
Environment=LT_EQUITY_USD=20
Environment=LT_PAPER=true
ExecStart=/home/admin/warroom/.venv/bin/python /home/admin/warroom/ops/paper20_cycle.py
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
