[Unit]
Description=War Room worker (jadwal deklaratif: publish-facts, freshness)
Documentation=file:///home/admin/warroom/docs/p1-progress.md
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/warroom
Environment=HOME=/home/admin
Environment=WARROOM_DOMAIN_HOME=/home/admin/live-trading
# Kredensial DB dibaca systemd (root) lalu di-inject ke proses — berkas tetap 600 root.
EnvironmentFile=/etc/warroom/db.env
ExecStart=/home/admin/warroom/.venv/bin/python -m warroom_worker.run --every 30
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# CATATAN KEAMANAN: `NoNewPrivileges` sengaja TIDAK dipakai.
# Sumber /var/lib/poly-* dan /etc/poly-pilot dimiliki user lain (mode 700), dan pola
# yang SUDAH ADA di host ini adalah `sudo -n cat` (unit domain juga begitu).
# Alternatifnya — memberi ACL baca ke admin di direktori proyek lain — ditolak karena
# berarti mengubah permission milik proyek yang tidak boleh kita sentuh.
PrivateTmp=true

[Install]
WantedBy=multi-user.target