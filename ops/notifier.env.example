# Contoh konfigurasi notifier (W5). Salin ke /etc/warroom/notifier.env (mode 600, root):
#
#   sudo install -m 600 -o root -g root ops/notifier.env.example /etc/warroom/notifier.env
#   sudo systemctl restart warroom-worker.service warroom-api.service
#
# Dibaca oleh services/notifier (`transport_from_env`) lewat:
#   1) environment unit systemd (EnvironmentFile=/etc/warroom/notifier.env), lalu
#   2) fallback membaca berkas yang sama dari proses (berguna untuk skrip root).
#
# Aturan: kredensial TIDAK PERNAH masuk repo, log, atau badan pesan. Yang dikirim hanya
# subjek, pesan, severity, dan aksi yang disarankan. Tanpa isi yang sah, transport = null
# dan alert tetap di DB — dan status itu ditampilkan apa adanya di UI (bukan "terkirim").

# --- Opsi A: Telegram langsung (paling sederhana) ---------------------------------------
# Token dari @BotFather; chat id dari getUpdates (kirim /start dulu ke bot).
# Thread id opsional untuk forum topic (mis. topik "War Room").
WARROOM_TELEGRAM_BOT_TOKEN=
WARROOM_TELEGRAM_CHAT_ID=
# WARROOM_TELEGRAM_THREAD_ID=

# --- Opsi B: webhook HTTP apa pun (bridge buatan sendiri, n8n, dll.) --------------------
# Menerima POST JSON: {subject, message, severity, detail}
# Token opsional dikirim sebagai header `Authorization: Bearer <token>`.
# WARROOM_ALERT_WEBHOOK=https://contoh.internal/webhook/warroom
# WARROOM_ALERT_TOKEN=

# Catatan: hanya SATU opsi yang perlu diisi. Telegram diprioritaskan bila keduanya ada.
