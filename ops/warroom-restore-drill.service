[Unit]
Description=War Room: drill restore Postgres (DB uji, hapus setelah verifikasi)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/admin/warroom
ExecStart=/usr/bin/env bash /home/admin/warroom/ops/restore-drill.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
