[Unit]
Description=War Room API (FastAPI: REST /api/v1/* + SSE)
Documentation=file:///home/admin/warroom/docs/p1-progress.md
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/warroom
Environment=HOME=/home/admin
Environment=WARROOM_DOMAIN_HOME=/home/admin/live-trading
# Scraper lokal (Prometheus di host yang sama) boleh membaca /metrics tanpa cookie.
Environment=WARROOM_METRICS_PUBLIC=1
EnvironmentFile=/etc/warroom/db.env
EnvironmentFile=/etc/warroom/llm.env
# Opsional: dipakai endpoint /api/v1/alerts untuk melaporkan status transport.
EnvironmentFile=-/etc/warroom/notifier.env
# Identitas build untuk verifikasi build<->proses (ops/set-build-id.sh).
EnvironmentFile=-/etc/warroom/build.env
# P0-4: pastikan skema DB di head alembic sebelum proses naik. Mencegah kejadian
# 14 Okt 2026 (produksi tertinggal 3 revisi). Gagal = unit gagal start (terlihat).
ExecStartPre=/home/admin/warroom/.venv/bin/python /home/admin/warroom/ops/check-db-head.py --upgrade
ExecStart=/home/admin/warroom/.venv/bin/uvicorn warroom_api.app:app --host 127.0.0.1 --port 8800 --log-level warning
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# CATATAN KEAMANAN: `NoNewPrivileges` sengaja TIDAK dipakai.
# Sumber /var/lib/poly-* dan /etc/poly-pilot dimiliki user lain (mode 700), dan pola
# yang SUDAH ADA di host ini adalah `sudo -n cat` (unit domain juga begitu).
# Alternatifnya — memberi ACL baca ke admin di direktori proyek lain — ditolak karena
# berarti mengubah permission milik proyek yang tidak boleh kita sentuh.
PrivateTmp=true

[Install]
WantedBy=multi-user.target