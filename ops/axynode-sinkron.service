[Unit]
Description=War Room: sinkron feed AXYNODE (funding perp + FNG) — sumber publik
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
WorkingDirectory=/home/admin/warroom
EnvironmentFile=/etc/warroom/db.env
ExecStart=/home/admin/warroom/.venv/bin/python /home/admin/warroom/ops/axynode_sinkron.py
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
